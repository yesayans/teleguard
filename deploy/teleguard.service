[Unit]
Description=TeleGuard AI Voice Detection Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/teleguard
ExecStart=/var/www/teleguard/venv/bin/uvicorn prototype.server:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
